// ForgeVest v6 — linear token vesting (NOT INDEPENDENTLY AUDITED).
//
// The script names the token it holds (`tokenId`, the token's covenant id) and carries a
// per-vesting `salt`, so every vesting has its own script.
//
// A plain script (pay-to-script-hash), not a covenant, like ForgeLock. KCC-20 tokens are locked
// by giving them the owner scheme p2sh with this script's hash as owner; they then only move in a
// transaction that also spends a coin locked to this same script, and that coin only opens by
// the rules below. Only a SIGHASH_ALL signature is accepted, so a signature always covers the
// whole transaction, including where the unlocked tokens go.
//
// Schedule: nothing before `cliffDaa`; from then on `total` unlocks in a straight line between
// `startDaa` and `endDaa` (so at the cliff, everything accrued since the start unlocks at once);
// everything is free at `endDaa`. A cliff equal to the start is plain linear vesting. The span
// `endDaa - startDaa` must be at most MAX_SPAN (about 2000 days); ForgeVault never builds a
// longer one and the Rust checker fails it.
//
// claim: the beneficiary takes any amount that has unlocked by DAA score `t` (the transaction's
// lock time proves `t` has been reached). Whatever is still locked at `t` must stay owned by
// this script, with borrowing disabled, together with a new lock coin, so later claims work the
// same way. The script is stateless: the same hash holds the remainder after every claim.
//
// `total` is what the schedule protects: lock exactly `total` tokens (ForgeVault always does).
// Works for KCC-20 tokens of the reference template (template hash first in the state, owner
// scheme 3 = p2sh). Not for KRON's own token format: lock those with ForgeLock dates.

contract ForgeVest(
    pubkey beneficiary,
    int total,
    int startDaa,
    int cliffDaa,
    int endDaa,
    int tplPrefixLen,
    int tplSuffixLen,
    byte[32] tokenTemplateHash,
    byte[32] tokenId,
    byte[32] salt
) {
    struct TokenState {
        byte[32] tokTemplate;
        int amount;
        byte[32] owner;
        byte ownerScheme;
        byte borrowScheme;
        byte[32] borrowGuard;
        byte[32] extension;
    }

    byte constant OWNER_P2SH = 0x03;
    byte constant BORROW_DISABLED = 0x00;
    // ~2000 days of DAA score: keeps the share arithmetic inside 64 bits
    int constant MAX_SPAN = 1728000000;

    // P2SH spk bytes: version(2) | OpBlake2b | OpData32 | hash(32) | OpEqual
    function myScriptHash() : byte[] {
        return(this.activeScriptPubKey.slice(4, 36));
    }

    // tokens unlocked by DAA score t (rounded down)
    function vestedAt(int t) : int {
        int v = 0;
        if (t >= endDaa) {
            v = total;
        } else {
            if (t >= cliffDaa) {
                int span = endDaa - startDaa;
                int done = t - startDaa;
                v = (total / span) * done + ((total % span) * done) / span;
            }
        }
        return(v);
    }

    // t: a DAA score the transaction's lock time has reached. tIn: our token input.
    // rest/rOut: the still-locked remainder and its output; cOut: the new lock coin.
    entry claim(sig s, int t, int tIn, TokenState rest, int rOut, int cOut) {
        // a 64-byte Schnorr signature and its sighash type: SIGHASH_ALL (0x01) only
        byte[] sb = byte[](s);
        require(sb.length == 65);
        require(sb.slice(64, 65) == byte[](0x01));
        require(checkSig(s, beneficiary));
        require(total > 0);
        require(startDaa >= 0);
        require(endDaa > startDaa);
        require(endDaa - startDaa <= MAX_SPAN);
        require(cliffDaa >= startDaa);
        require(cliffDaa <= endDaa);
        require(t >= startDaa);
        require(tx.daa >= t);
        // the vesting's own token, nothing else: another token owned by this script cannot
        // stand in for it
        require(OpInputCovenantId(tIn) == tokenId);
        // `salt` only makes this vesting's script its own. This check always holds (a script
        // cannot contain its own hash) and keeps the salt in the compiled script.
        require(byte[](salt) != myScriptHash());
        TokenState tok = readInputStateWithTemplate(tIn, tplPrefixLen, tplSuffixLen, tokenTemplateHash);
        require(tok.tokTemplate == tokenTemplateHash);
        require(tok.ownerScheme == OWNER_P2SH);
        require(byte[](tok.owner) == myScriptHash());
        // a piece that can still be borrowed is not a locked piece
        require(tok.borrowScheme == BORROW_DISABLED);
        int locked = total - vestedAt(t);
        if (locked > 0) {
            require(rest.tokTemplate == tokenTemplateHash);
            require(rest.ownerScheme == OWNER_P2SH);
            require(byte[](rest.owner) == myScriptHash());
            require(rest.borrowScheme == BORROW_DISABLED);
            require(rest.amount >= locked);
            require(OpOutputCovenantId(rOut) == OpInputCovenantId(tIn));
            validateOutputStateWithInputTemplate(rOut, rest, tIn, tplPrefixLen, tplSuffixLen, tokenTemplateHash);
            require(tx.outputs[cOut].scriptPubKey == this.activeScriptPubKey);
            require(tx.outputs[cOut].value >= tx.inputs[this.activeInputIndex].value);
        }
    }
}
